ADMIN_USERNAME=change-me
# Keep bcrypt hashes single-quoted. Copy the complete line from npm run auth:hash.
ADMIN_PASSWORD_HASH='generated-bcrypt-hash'
SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:8888
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
